load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")

py_test(
    name = "check_spdx",
    size = "small",
    srcs = ["check_spdx.py"],
    data = ["//:MODULE.bazel"],
    main = "check_spdx.py",
    # Reads the real working tree, and its only declared input is MODULE.bazel,
    # so it must not be sandboxed or cached.
    tags = [
        "external",
        "local",
        "no-sandbox",
    ],
    deps = ["@rules_python//python/runfiles"],
)

py_binary(
    name = "check_notice",
    srcs = ["check_notice.py"],
    data = [
        "@go_sdk//:bin/go",
        "@go_sdk//:files",
        "@multitool//tools/syft",
    ],
    env = {
        "CHECK_NOTICE_GO": "$(rlocationpath @go_sdk//:bin/go)",
        "CHECK_NOTICE_SYFT": "$(rlocationpath @multitool//tools/syft)",
    },
    visibility = ["//visibility:public"],
    deps = ["@rules_python//python/runfiles"],
)

py_test(
    name = "fern_docs_versions_test",
    size = "small",
    srcs = [
        "fern_docs_versions.py",
        "fern_docs_versions_test.py",
    ],
    data = ["//:fern/docs.yml"],
    main = "fern_docs_versions_test.py",
    # Builds throwaway repositories with the host git.
    tags = ["local"],
    deps = ["@rules_python//python/runfiles"],
)
