# APT package layers baked into container images.
#
# The go-health-validation image needs `journalctl` at runtime: the Xid checks
# shell out to it to read the host's systemd journal. The Ubuntu base
# (see oci.MODULE.bazel) is minimal and ships no systemd, so we resolve the
# `systemd` package (which provides /usr/bin/journalctl) plus its transitive
# dependencies from the Ubuntu archive and add the flattened result as an
# image layer (@journalctl//:flat).
#
# Regenerating the lock (required whenever journalctl.yaml changes):
#
#     bazel run @journalctl//:lock
#
# Lock generation fetches the Ubuntu package indices over the network; the
# resolved, sha256-pinned lock is committed so builds stay hermetic.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    name = "journalctl",
    lock = "//third_party/apt:journalctl.lock.json",
    manifest = "//third_party/apt:journalctl.yaml",
    # The base is merged-usr (/lib -> usr/lib). Some debs still ship legacy /lib
    # paths, and extracting a real ./lib/ over that symlink makes the runtime
    # replace it with a directory. Hoist those paths under /usr instead.
    mergedusr = True,
)
use_repo(apt, "journalctl")
