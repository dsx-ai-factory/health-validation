go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.from_file(
    name = "go_sdk",
    go_mod = "//:go.mod",
)
go_sdk.nogo(nogo = "//tools/go/nogo")
use_repo(go_sdk, "go_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_work = "//:go.work")

# cel-go ships its own pre-existing BUILD.bazel files, which use the legacy
# go_default_library-only target naming. That naming convention doesn't get
# picked up by rules_go's Go build-info embedding (see
# https://github.com/bazel-contrib/rules_go/pull/4595), so cel-go silently
# drops out of the linked binary's `go version -m` module list. Force a clean
# regeneration so Gazelle emits the modern importpath-named target (with a
# go_default_library alias for compatibility), matching every other go_deps
# repo.
go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "github.com/google/cel-go",
)
use_repo(
    go_deps,
    "co_honnef_go_tools",
    "com_github_google_cel_go",
    "com_github_google_uuid",
    "com_github_nvidia_go_dcgm",
    "com_github_nvidia_go_nvlib",
    "com_github_nvidia_go_nvml",
    "com_github_soheilhy_cmux",
    "com_github_stretchr_testify",
    "in_gopkg_yaml_v3",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_tools",
)
