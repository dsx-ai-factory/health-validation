load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//build/visibility:collect_consumers"])

go_library(
    name = "observation",
    srcs = [
        "doc.go",
        "observation.go",
        "validation.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/observation",
    deps = [
        "//collect/proto/go/health/v1:health",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "observation_test",
    srcs = [
        "extended_test.go",
        "observation_test.go",
    ],
    data = ["testdata/gpu_inventory.json"],
    embed = [":observation"],
    deps = [
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
