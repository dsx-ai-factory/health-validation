load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "infiniband",
    srcs = ["sensor.go"],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/sensors/infiniband",
    visibility = ["//visibility:public"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/infiniband",
        "//collect/source/infiniband",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "infiniband_test",
    srcs = ["sensor_test.go"],
    embed = [":infiniband"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/infiniband",
        "//collect/source/infiniband",
    ],
)
