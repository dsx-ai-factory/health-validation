load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "nvml",
    srcs = [
        "doc.go",
        "observe.go",
        "sensor.go",
        "temperature.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/sensors/nvml",
    visibility = ["//visibility:public"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/gpu",
        "//collect/source/nvml",
        "//collect/source/nvml/device",
        "@com_github_nvidia_go_nvml//pkg/nvml",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "nvml_test",
    srcs = [
        "sensor_test.go",
        "temperature_test.go",
    ],
    embed = [":nvml"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/gpu",
        "//collect/source/nvml/device",
        "@com_github_nvidia_go_nvml//pkg/nvml",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
