load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "nvml",
    srcs = [
        "doc.go",
        "gpm.go",
        "interconnect.go",
        "inventory.go",
        "observe.go",
        "power.go",
        "processes.go",
        "reliability.go",
        "sensor.go",
        "telemetry.go",
        "temperature.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/sensors/nvml",
    visibility = ["//visibility:public"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/gpu",
        "//collect/source/nvml",
        "//collect/source/nvml/device",
        "//collect/source/process",
        "@com_github_nvidia_go_nvml//pkg/nvml",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "nvml_test",
    srcs = [
        "cycle_test.go",
        "gpm_lifetime_test.go",
        "gpm_test.go",
        "gpm_window_test.go",
        "interconnect_test.go",
        "inventory_test.go",
        "power_test.go",
        "processes_test.go",
        "reliability_test.go",
        "sensor_test.go",
        "telemetry_boundary_test.go",
        "telemetry_test.go",
        "temperature_test.go",
    ],
    embed = [":nvml"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/gpu",
        "//collect/source/nvml",
        "//collect/source/nvml/device",
        "@com_github_nvidia_go_nvml//pkg/nvml",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
