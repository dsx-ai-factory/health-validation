load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//build/visibility:collect_consumers"])

go_library(
    name = "fuse",
    srcs = ["sensor.go"],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/sensors/fuse",
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/fuse",
        "//collect/source/fuse",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "fuse_test",
    srcs = ["sensor_test.go"],
    embed = [":fuse"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/fuse",
    ],
)
