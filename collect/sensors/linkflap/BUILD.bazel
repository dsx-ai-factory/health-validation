load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "linkflap",
    srcs = ["sensor.go"],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/sensors/linkflap",
    visibility = ["//visibility:public"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/infiniband",
        "//collect/source/journal",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "linkflap_test",
    srcs = ["sensor_test.go"],
    embed = [":linkflap"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/infiniband",
        "//collect/source/journal",
        "@com_github_stretchr_testify//require",
    ],
)
