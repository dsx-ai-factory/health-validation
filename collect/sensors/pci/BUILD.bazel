load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "pci",
    srcs = ["sensor.go"],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/sensors/pci",
    visibility = ["//visibility:public"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/pci",
        "//collect/source/pci",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "pci_test",
    srcs = [
        "properties_test.go",
        "sensor_test.go",
    ],
    embed = [":pci"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/pci",
    ],
)
