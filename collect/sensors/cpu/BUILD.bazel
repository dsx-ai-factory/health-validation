load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cpu",
    srcs = [
        "list.go",
        "sensor.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/sensors/cpu",
    visibility = ["//visibility:public"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/cpu",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "cpu_test",
    srcs = [
        "list_test.go",
        "sensor_test.go",
    ],
    embed = [":cpu"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/cpu",
    ],
)
