load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "pstore",
    srcs = ["sensor.go"],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/sensors/pstore",
    visibility = ["//visibility:public"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/pstore",
        "//collect/source/pstore",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "pstore_test",
    srcs = ["sensor_test.go"],
    embed = [":pstore"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/pstore",
    ],
)
