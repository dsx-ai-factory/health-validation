load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "host",
    srcs = ["sensor.go"],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/sensors/host",
    visibility = ["//visibility:public"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/host",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "host_test",
    srcs = ["sensor_test.go"],
    embed = [":host"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/host",
    ],
)
