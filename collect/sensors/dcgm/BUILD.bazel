load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//build/visibility:collect_consumers"])

go_library(
    name = "dcgm",
    srcs = [
        "doc.go",
        "health.go",
        "sensor.go",
        "signals.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/sensors/dcgm",
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/sensorids",
        "//collect/signals/dcgmhealth",
        "//collect/signals/gpu",
        "//collect/source/dcgm",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "dcgm_test",
    srcs = [
        "health_test.go",
        "sensor_test.go",
    ],
    embed = [":dcgm"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/dcgmhealth",
        "//collect/signals/gpu",
        "//collect/source/dcgm",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
