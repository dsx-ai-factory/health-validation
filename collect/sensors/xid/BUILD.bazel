load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//build/visibility:collect_consumers"])

go_test(
    name = "xid_test",
    srcs = ["sensor_test.go"],
    embed = [":xid"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/xid",
        "//collect/source/journal",
        "@com_github_stretchr_testify//require",
    ],
)

go_library(
    name = "xid",
    srcs = [
        "sensor.go",
        "time_range.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/sensors/xid",
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/xid",
        "//collect/source/journal",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
