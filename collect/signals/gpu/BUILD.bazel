load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//build/visibility:collect_consumers"])

go_library(
    name = "gpu",
    srcs = [
        "gpm.go",
        "interconnect.go",
        "processes.go",
        "reliability.go",
        "signals.go",
        "telemetry.go",
