load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "kmsg",
    srcs = [
        "message.go",
        "read.go",
        "read_linux.go",
        "read_other.go",
        "stream.go",
        "stream_linux.go",
        "stream_other.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/source/kmsg",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "kmsg_test",
    srcs = [
        "gpud_test.go",
        "message_test.go",
        "read_test.go",
        "sensor_test.go",
        "stream_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":kmsg"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/sensors/kmsg",
        "//collect/signals/kmsg",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
