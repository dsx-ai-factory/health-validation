load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//build/visibility:collect_consumers"])

go_library(
    name = "rdmatopo",
    srcs = [
        "capabilities_linux.go",
        "capabilities_other.go",
        "parse.go",
        "source.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/source/rdmatopo",
    deps = select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "rdmatopo_test",
    srcs = ["source_test.go"],
    embed = [":rdmatopo"],
    deps = ["@com_github_stretchr_testify//require"],
)
