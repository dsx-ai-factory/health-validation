load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//build/visibility:collect_consumers"])

go_library(
    name = "infiniband",
    srcs = [
        "fields.go",
        "parse.go",
        "source.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/source/infiniband",
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/infiniband",
    ],
)

go_test(
    name = "infiniband_test",
    srcs = [
        "gpud_test.go",
        "source_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":infiniband"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/infiniband",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
