load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//build/visibility:collect_consumers"])

go_library(
    name = "pci",
    srcs = ["source.go"],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/source/pci",
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/pci",
    ],
)

go_test(
    name = "pci_test",
    srcs = ["source_test.go"],
    embed = [":pci"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/pci",
    ],
)
