load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dcgm",
    srcs = [
        "doc.go",
        "errors.go",
        "errors_linux.go",
        "fields_linux.go",
        "gpu_inventory.go",
        "gpu_inventory_linux.go",
        "metrics.go",
        "native.go",
        "native_linux.go",
        "native_unsupported.go",
        "source.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/source/dcgm",
    visibility = ["//visibility:public"],
    deps = [
        "//collect",
        "//collect/observation",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ] + select({
        "@rules_go//go/platform:android": [
            "//collect/signals/gpu",
            "@com_github_nvidia_go_dcgm//pkg/dcgm",
        ],
        "@rules_go//go/platform:linux": [
            "//collect/signals/gpu",
            "@com_github_nvidia_go_dcgm//pkg/dcgm",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "dcgm_test",
    srcs = [
        "errors_linux_test.go",
        "errors_test.go",
        "fields_linux_test.go",
        "gpu_inventory_linux_test.go",
        "source_test.go",
    ],
    embed = [":dcgm"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/gpu",
    ] + select({
        "@rules_go//go/platform:android": [
            "@com_github_nvidia_go_dcgm//pkg/dcgm",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_nvidia_go_dcgm//pkg/dcgm",
        ],
        "//conditions:default": [],
    }),
)
