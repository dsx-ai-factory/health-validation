load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "disk",
    srcs = [
        "mount.go",
        "source.go",
        "statfs_darwin.go",
        "statfs_linux.go",
        "statfs_other.go",
        "statfs_unix.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/source/disk",
    visibility = ["//visibility:public"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/disk",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:ios": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "disk_test",
    srcs = [
        "mount_identity_test.go",
        "mount_test.go",
        "mount_view_test.go",
        "source_test.go",
        "statfs_linux_test.go",
        "statfs_unix_test.go",
    ],
    embed = [":disk"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/disk",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)
