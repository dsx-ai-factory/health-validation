load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "nvml",
    srcs = [
        "doc.go",
        "instance.go",
        "metadata.go",
        "version.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/collect/source/nvml",
    visibility = ["//visibility:public"],
    deps = [
        "//collect/source/nvml/device",
        "//collect/source/nvml/lib",
        "@com_github_nvidia_go_nvml//pkg/nvml",
    ],
)

go_test(
    name = "nvml_test",
    srcs = [
        "instance_test.go",
        "metadata_test.go",
    ],
    embed = [":nvml"],
    deps = [
        "//collect/source/nvml/device",
        "//collect/source/nvml/lib",
        "@com_github_nvidia_go_nvlib//pkg/nvlib/device",
        "@com_github_nvidia_go_nvml//pkg/nvml",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
