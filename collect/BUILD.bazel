# gazelle:default_visibility //build/visibility:collect_consumers

load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//build/visibility:collect_consumers"])

go_library(
    name = "collect",
    srcs = [
        "collect.go",
        "cycle.go",
        "doc.go",
        "signals.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/collect",
    deps = [
        "//collect/observation",
    ],
)

go_test(
    name = "collect_test",
    srcs = [
        "collect_test.go",
        "cycle_test.go",
    ],
    embed = [":collect"],
    deps = [
        "//collect/signals/gpu",
    ],
)
