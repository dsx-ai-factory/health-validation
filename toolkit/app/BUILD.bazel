load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "app",
    srcs = [
        "app.go",
        "backend_linux.go",
        "backend_other.go",
        "collect.go",
        "config.go",
        "version.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/toolkit/app",
    visibility = ["//visibility:public"],
    deps = [
        "//catalog",
        "//catalog/health",
        "//collect",
        "//collect/observation",
        "//collect/sensors/cpu",
        "//collect/sensors/infiniband",
        "//toolkit",
        "//toolkit/internal/collectadapters",
        "//toolkit/internal/collectbridge",
        "//toolkit/internal/version",
        "//toolkit/observations",
        "//toolkit/otelmetrics",
        "@com_github_google_uuid//:uuid",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@org_golang_google_protobuf//encoding/protojson",
    ] + select({
        "@rules_go//go/platform:linux": [
            "//toolkit/nvml",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "app_test",
    srcs = [
        "app_test.go",
        "collect_test.go",
        "config_test.go",
        "version_test.go",
    ],
    embed = [":app"],
    deps = [
        "//catalog",
        "//catalog/catalogtest",
        "//catalog/cpu",
        "//catalog/gpu",
        "//catalog/health",
        "//catalog/infiniband",
        "//catalog/node",
        "//catalog/nvlink",
        "//collect",
        "//collect/observation",
        "//collect/sensors/cpu",
        "//collect/sensors/infiniband",
        "//collect/signals/cpu",
        "//collect/signals/gpu",
        "//collect/signals/infiniband",
        "//collect/source/infiniband",
        "//toolkit",
        "//toolkit/internal/collectadapters",
        "//toolkit/observations",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
