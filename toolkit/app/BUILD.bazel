load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//build/visibility:toolkit_consumers"])

go_library(
    name = "app",
    srcs = [
        "app.go",
        "backend_linux.go",
        "backend_other.go",
        "collect.go",
        "config.go",
        "evaluation.go",
        "serve.go",
        "version.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/toolkit/app",
    deps = [
        "//agentkit/server",
        "//catalog",
        "//catalog/health",
        "//collect",
        "//collect/observation",
        "//collect/sensors/cpu",
        "//collect/sensors/xid",
        "//internal/version",
        "//proto/go/health/v1:health",
        "//toolkit",
        "//toolkit/internal/collectadapters",
        "//toolkit/internal/collectbridge",
        "//toolkit/internal/gpuinventory",
        "//toolkit/observations",
        "//toolkit/otelmetrics",
        "//toolkit/verdictproto",
        "@com_github_google_uuid//:uuid",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
    ] + select({
        "@rules_go//go/platform:linux": [
            "//collect/source/nvml",
            "//toolkit/nvml",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "app_test",
    srcs = [
        "app_test.go",
        "backend_lifecycle_linux_test.go",
        "collect_test.go",
        "config_test.go",
        "discovery_linux_test.go",
        "entity_test.go",
        "evaluation_test.go",
        "node_parity_linux_test.go",
        "serve_test.go",
        "version_test.go",
        "xid_collect_test.go",
    ],
    embed = [":app"],
    deps = [
        "//agentkit/server",
        "//catalog",
        "//catalog/catalogtest",
        "//catalog/cpu",
        "//catalog/gpu",
        "//catalog/health",
        "//catalog/node",
        "//catalog/nvlink",
        "//catalog/xid",
        "//collect",
        "//collect/observation",
        "//collect/sensors/cpu",
        "//collect/sensors/xid",
        "//collect/signals/cpu",
        "//collect/signals/gpu",
        "//collect/signals/xid",
        "//proto/go/health/v1:health",
        "//toolkit",
        "//toolkit/internal/collectadapters",
        "//toolkit/internal/gpuinventory",
        "//toolkit/observations",
        "//toolkit/verdictproto",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ] + select({
        "@rules_go//go/platform:linux": [
            "//collect/source/nvml",
            "//collect/source/nvml/device",
            "//toolkit/nvml",
            "@com_github_nvidia_go_nvml//pkg/nvml",
            "@com_github_nvidia_go_nvml//pkg/nvml/mock",
        ],
        "//conditions:default": [],
    }),
)
