load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_go//go:def.bzl", "go_library")
load("//build/rules/go:defs.bzl", "go_binary")
load("//build/rules/go:shipped_modules.bzl", "go_linked_modules", "go_shipped_modules")

go_library(
    name = "health-validation_lib",
    srcs = ["main.go"],
    importpath = "github.com/dsx-ai-factory/health-validation/toolkit/cmd/health-validation",
    visibility = ["//visibility:private"],
    deps = ["//toolkit/app"],
)

go_binary(
    name = "health-validation",
    embed = [":health-validation_lib"],
    # Package the CLI into a multi-arch (linux/amd64 + linux/arm64) OCI image
    # with /health-validation as the entrypoint, so `docker run <image> run` mirrors
    # `health-validation run`. The Ubuntu base is
    # required: health-validation is a cgo binary that dlopen()s libnvidia-ml.so.1 from
    # the host driver at runtime, so it needs a glibc userland (not scratch /
    # static-distroless). The driver itself is injected by the NVIDIA Container
    # Toolkit at run time, not baked into the image.
    oci = True,
    # journalctl (Xid/RDMA link-flap checks) is bind-mounted from the host at
    # runtime instead of bundled here, to avoid tracking systemd's apt churn.
    # See scripts/health-validation-run.sh and docs/integration.md.
    visibility = ["//visibility:public"],
    # Stamped only under --config=release (see .bazel/release.bazelrc); plain
    # builds leave the version defaults ("dev"). The {STABLE_*} keys are
    # produced by the --workspace_status_command set in .bazel/release.bazelrc.
    x_defs = {
        "github.com/dsx-ai-factory/health-validation/catalog/version.version": "{STABLE_HEALTH_VALIDATION_CATALOG_VERSION}",
        "github.com/dsx-ai-factory/health-validation/toolkit/internal/version.version": "{STABLE_HEALTH_VALIDATION_VERSION}",
        "github.com/dsx-ai-factory/health-validation/toolkit/internal/version.commit": "{STABLE_GIT_COMMIT}",
        "github.com/dsx-ai-factory/health-validation/toolkit/internal/version.date": "{STABLE_BUILD_DATE}",
    },
)

# The module list the Go linker embedded in the shipped linux binary. See
# build/rules/go/shipped_modules.bzl for what this does and does not cover.
go_shipped_modules(
    name = "shipped_modules",
    binary = ":health-validation",
)

write_source_files(
    name = "shipped_modules_update",
    files = {"SHIPPED_MODULES.txt": ":shipped_modules"},
)

# Cross-check: the module set the Bazel graph says is linked, versus the set the
# linker embedded. The golden test above cannot see a module that is linked but
# missing from the embedded list, because it regenerates from that same list.
go_linked_modules(
    name = "linked_modules",
    binary = ":health-validation",
    recorded = ":recorded_modules",
)

genrule(
    name = "recorded_modules",
    srcs = ["SHIPPED_MODULES.txt"],
    outs = ["recorded_modules.txt"],
    cmd = "set -o pipefail; grep -E '^[^#[:space:]]' $< | cut -f1 > $@",
)

diff_test(
    name = "shipped_modules_cross_check",
    failure_message = "The Bazel graph and SHIPPED_MODULES.txt disagree. A line only on the " +
                      "right is linked but unrecorded; regenerate with 'bazel run " +
                      "//toolkit/cmd/health-validation:shipped_modules_update'. An ABSORBED " +
                      "line means two modules folded together, which the record cannot express.",
    file1 = ":recorded_modules",
    file2 = ":linked_modules",
)
