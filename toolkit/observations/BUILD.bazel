load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "observations",
    srcs = [
        "export.go",
        "ingest.go",
        "mapping.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/toolkit/observations",
    visibility = ["//visibility:public"],
    deps = [
        "//catalog/cpu",
        "//catalog/gpu",
        "//catalog/health",
        "//catalog/infiniband",
        "//catalog/node",
        "//catalog/nvlink",
        "//catalog/xid",
        "//collect",
        "//collect/observation",
        "//collect/signals/cpu",
        "//collect/signals/gpu",
        "//collect/signals/infiniband",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "observations_test",
    srcs = [
        "export_test.go",
        "infiniband_test.go",
        "observations_test.go",
        "roundtrip_test.go",
        "unsigned_test.go",
    ],
    embed = [":observations"],
    deps = [
        "//catalog",
        "//catalog/cpu",
        "//catalog/gpu",
        "//catalog/health",
        "//catalog/infiniband",
        "//catalog/node",
        "//catalog/nvlink",
        "//catalog/xid",
        "//collect",
        "//collect/observation",
        "//collect/signals/cpu",
        "//collect/signals/gpu",
        "//collect/signals/infiniband",
        "//collect/signals/process",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
