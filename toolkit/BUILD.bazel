# gazelle:default_visibility //build/visibility:toolkit_consumers

load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//build/visibility:toolkit_consumers"])

go_library(
    name = "toolkit",
    srcs = [
        "collect.go",
        "doc.go",
        "sensor.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/toolkit",
    deps = [
        "//catalog",
        "//catalog/health",
    ],
)

go_test(
    name = "toolkit_test",
    srcs = [
        "collect_test.go",
        "entity_test.go",
        "example_test.go",
        "static_sensor_test.go",
    ],
    deps = [
        ":toolkit",
        "//catalog",
        "//catalog/catalogtest",
        "//catalog/gpu",
        "//catalog/health",
        "//catalog/node",
        "//catalog/nvlink",
    ],
)
