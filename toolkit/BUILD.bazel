load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/NVIDIA/health-validation/toolkit

go_library(
    name = "toolkit",
    srcs = [
        "accumulator.go",
        "actuator.go",
        "collect.go",
        "doc.go",
        "gpu_backend.go",
        "gpu_sensor.go",
        "lazy_backend.go",
        "node_backend.go",
        "node_sensor.go",
        "nvlink_backend.go",
        "nvlink_sensor.go",
        "sensor.go",
        "xid_backend.go",
        "xid_parse.go",
        "xid_sensor.go",
    ],
    importpath = "github.com/NVIDIA/health-validation/toolkit",
    visibility = ["//visibility:public"],
    deps = [
        "//catalog",
        "//catalog/gpu",
        "//catalog/health",
        "//catalog/node",
        "//catalog/nvlink",
        "//catalog/xid",
    ],
)

go_test(
    name = "toolkit_test",
    srcs = [
        "collect_test.go",
        "example_test.go",
        "gpu_sensor_test.go",
        "lazy_backend_test.go",
        "node_sensor_test.go",
        "xid_backend_internal_test.go",
        "xid_parse_test.go",
        "xid_sensor_test.go",
    ],
    embed = [":toolkit"],
    deps = [
        "//catalog",
        "//catalog/gpu",
        "//catalog/health",
        "//catalog/node",
        "//catalog/nvlink",
        "//catalog/xid",
    ],
)
