# gazelle:default_visibility //build/visibility:toolkit_consumers

load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//build/visibility:toolkit_consumers"])

go_library(
    name = "toolkit",
    srcs = [
        "collect.go",
        "doc.go",
        "ib_backend.go",
        "ib_sensor.go",
        "journal.go",
        "rdma_linkflap_backend.go",
        "rdma_linkflap_parse.go",
        "rdma_linkflap_sensor.go",
        "sensor.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/toolkit",
    deps = [
        "//catalog",
        "//catalog/health",
        "//catalog/infiniband",
    ],
)

go_test(
    name = "toolkit_test",
    srcs = [
        "collect_test.go",
        "entity_test.go",
        "example_test.go",
        "export_test.go",
        "journal_internal_test.go",
        "linkflap_parity_internal_test.go",
        "rdma_linkflap_backend_internal_test.go",
        "rdma_linkflap_parse_test.go",
        "rdma_linkflap_sensor_test.go",
        "static_sensor_test.go",
    ],
    embed = [":toolkit"],
    deps = [
        "//catalog",
        "//catalog/catalogtest",
        "//catalog/gpu",
        "//catalog/health",
        "//catalog/infiniband",
        "//catalog/node",
        "//catalog/nvlink",
        "//collect",
        "//collect/sensors/infiniband",
        "//collect/sensors/linkflap",
        "//collect/source/infiniband",
        "//collect/source/journal",
        "//toolkit/internal/collectadapters",
        "//toolkit/internal/collectbridge",
    ],
)
