load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "collectadapters",
    srcs = ["adapters.go"],
    importpath = "github.com/dsx-ai-factory/health-validation/toolkit/internal/collectadapters",
    visibility = ["//toolkit:__subpackages__"],
    deps = [
        "//catalog/cpu",
        "//catalog/gpu",
        "//catalog/health",
        "//catalog/infiniband",
        "//catalog/nvlink",
        "//collect/observation",
        "//toolkit/observations",
    ],
)

go_test(
    name = "collectadapters_test",
    srcs = [
        "adapters_test.go",
        "infiniband_test.go",
    ],
    embed = [":collectadapters"],
    deps = [
        "//catalog/cpu",
        "//catalog/gpu",
        "//catalog/health",
        "//catalog/infiniband",
        "//collect",
        "//collect/observation",
        "//collect/signals/cpu",
        "//collect/signals/gpu",
        "//collect/signals/infiniband",
        "//toolkit/observations",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
