load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "gpuinventory",
    srcs = [
        "architecture.go",
        "inventory.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/toolkit/internal/gpuinventory",
    visibility = ["//toolkit:__subpackages__"],
    deps = [
        "//collect",
        "//collect/observation",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "gpuinventory_test",
    srcs = ["inventory_test.go"],
    embed = [":gpuinventory"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/signals/gpu",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
