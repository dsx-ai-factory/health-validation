load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//build/rules/go:defs.bzl", "go_binary")

go_library(
    name = "scan-one-off-evaluate_lib",
    srcs = [
        "main.go",
        "measurements.go",
        "nvlink_measurements.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/agentkit/examples/scan-one-off-evaluate",
    visibility = ["//visibility:private"],
    deps = [
        "//catalog",
        "//catalog/gpu",
        "//catalog/health",
        "//catalog/nvlink",
        "//collect",
        "//collect/observation",
        "//collect/sensors/dcgm",
        "//collect/signals/gpu",
        "//collect/source/dcgm",
        "@com_github_google_uuid//:uuid",
    ],
)

go_binary(
    name = "scan-one-off-evaluate",
    embed = [":scan-one-off-evaluate_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "scan-one-off-evaluate_test",
    srcs = [
        "measurements_test.go",
        "nvlink_measurements_test.go",
    ],
    embed = [":scan-one-off-evaluate_lib"],
    deps = [
        "//catalog/gpu",
        "//catalog/health",
        "//catalog/nvlink",
        "//collect/observation",
        "//collect/signals/gpu",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
