load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//build/rules/go:defs.bzl", "go_binary")

go_library(
    name = "server-simple-collect_lib",
    srcs = ["main.go"],
    importpath = "github.com/dsx-ai-factory/health-validation/agentkit/examples/server-simple-collect",
    visibility = ["//visibility:private"],
    deps = [
        "//agentkit/server",
        "//collect",
        "//collect/sensors/cpu",
        "//collect/sensors/dcgm",
        "//collect/sensors/disk",
        "//collect/sensors/fuse",
        "//collect/sensors/host",
        "//collect/sensors/infiniband",
        "//collect/sensors/kmsg",
        "//collect/sensors/memory",
        "//collect/sensors/nvml",
        "//collect/sensors/pci",
        "//collect/sensors/process",
        "//collect/sensors/pstore",
        "//collect/signals/kmsg/memory",
        "//collect/signals/kmsg/xid",
        "//collect/source/dcgm",
        "//collect/source/kmsg",
        "//collect/source/nvml",
    ],
)

go_binary(
    name = "server-simple-collect",
    embed = [":server-simple-collect_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "server-simple-collect_test",
    srcs = ["main_test.go"],
    embed = [":server-simple-collect_lib"],
    deps = [
        "//collect/observation",
        "//collect/sensors/cpu",
        "//collect/signals/cpu",
    ],
)
