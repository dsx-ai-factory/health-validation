load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//build/rules/go:defs.bzl", "go_binary")

go_library(
    name = "scan-one-off_lib",
    srcs = ["main.go"],
    importpath = "github.com/dsx-ai-factory/health-validation/agentkit/examples/scan-one-off",
    visibility = ["//visibility:private"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/sensors/dcgm",
        "//collect/sensors/infiniband",
        "//collect/sensors/kmsg",
        "//collect/sensors/nvml",
        "//collect/signals/infiniband",
        "//collect/signals/kmsg",
        "//collect/signals/kmsg/memory",
        "//collect/signals/kmsg/xid",
        "//collect/source/dcgm",
        "//collect/source/nvml",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_binary(
    name = "scan-one-off",
    embed = [":scan-one-off_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "scan-one-off_test",
    srcs = ["main_test.go"],
    embed = [":scan-one-off_lib"],
    deps = [
        "//collect",
        "//collect/observation",
        "//collect/sensors/infiniband",
        "//collect/sensors/kmsg",
        "//collect/signals/infiniband",
        "//collect/signals/kmsg/xid",
        "//collect/source/infiniband",
        "//collect/source/kmsg",
        "@com_github_stretchr_testify//require",
    ],
)
