# Release / pre-release builds: stamp the version into the binary.
#
# Enables Bazel stamping. The workspace-status values feed the x_defs on the
# operator binary; plain builds stay unstamped and report the "dev" defaults.
common:release --stamp
common:release --workspace_status_command=./tools/workspace_status_release.sh

# Linux release/pre-release artifacts — use this instead of stacking
# `--config=ci --config=release` by hand:
#   bazel build --config=release-ci --platforms=//build/platforms:linux_amd64 //toolkit/cmd/health-validation:health-validation
#
# Apply the normal CI settings first, then add release stamping. Keeping release
# last also ensures its scalar flags win if CI later defines the same setting.
common:release-ci --config=ci
common:release-ci --config=release
