    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Explain a remediation step"
      },
      "description": "Explain what one remediation step in a verdict means, such as reset_gpu or hold, and list up to 30 checks in the compiled-in catalog that recommend it, optionally only with a given node state. Neither health-validation nor this server performs any step. Reads no node.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "description": "the remediation step to explain, as a verdict names it",
            "enum": [
              "check_collection",
              "hold",
              "reset_gpu",
              "restart_app",
              "restart_os",
              "retry_collection",
              "service_required",
              "stop_p2p_traffic",
              "update_swfw"
            ],
            "type": "string"
          },
          "operational_state": {
            "default": "ANY",
            "description": "only checks recommending the step with this node state, default ANY",
            "enum": [
              "ANY",
              "ready",
              "monitor",
              "drain"
            ],
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "name": "hv_explain_remediation",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string"
          },
          "assigned_by": {
            "description": "set when the engine, not a check definition, gives this step",
            "type": "string"
          },
          "catalog_version": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "operational_state_filter": {
            "type": "string"
          },
          "recommended_by": {
            "description": "check IDs in the compiled-in catalog that recommend this step",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "total": {
            "description": "how many checks recommend it, before the cap",
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "action",
          "meaning",
          "operational_state_filter",
          "catalog_version",
          "note",
          "recommended_by",
          "total",
          "truncated"
        ],
        "type": "object"
      },
      "title": "Explain a remediation step"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Get a node verdict"
      },
      "description": "Ask the local health-validation serve process to evaluate this node now and return a decision: scheduling_advice (READY, READY_LOW_COVERAGE, MONITOR, DRAIN, RETRY_COLLECTION or NO_VERDICT), overall severity, node state and ordered remediation steps, plus coverage, which says how many GPU, NVLink and Xid checks actually ran. detail=failing adds the failing checks' entities and fenced messages; detail=full adds skipped and passed checks, capped at 64 KiB. It starts real collection on the node, so it is rate limited and a second call while one runs is refused. It changes nothing on the node. Use hv_service_status first if serve may be down.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cadence": {
            "default": "ALL",
            "description": "run only the checks for this scheduling window, default ALL (every registered check)",
            "enum": [
              "ALL",
              "CONTINUOUS",
              "PROLOG",
              "MAINTENANCE"
            ],
            "type": "string"
          },
          "detail": {
            "default": "summary",
            "description": "summary (default), failing (adds entities and messages) or full (adds skipped and passed checks)",
            "enum": [
              "summary",
              "failing",
              "full"
            ],
            "type": "string"
          },
          "xid_lookback_minutes": {
            "default": 0,
            "description": "read Xid events from this many minutes ago; 0 (default) keeps serve's own window",
            "maximum": 10080,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "hv_get_verdict",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "catalog_version": {
            "description": "the catalog serve evaluated with",
            "type": "string"
          },
          "coverage": {
            "additionalProperties": false,
            "properties": {
              "checks_run": {
                "type": "integer"
              },
              "checks_skipped": {
                "type": "integer"
              },
              "gpu_checks_run": {
                "type": "integer"
              },
              "low_coverage": {
                "type": "boolean"
              },
              "low_coverage_reason": {
                "type": "string"
              },
              "nvlink_checks_run": {
                "type": "integer"
              },
              "skipped_by_reason": {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              "xid_checks_run": {
                "type": "integer"
              }
            },
            "required": [
              "skipped_by_reason",
              "checks_run",
              "checks_skipped",
              "gpu_checks_run",
              "nvlink_checks_run",
              "xid_checks_run",
              "low_coverage"
            ],
            "type": [
              "null",
              "object"
            ]
          },
          "decision": {
            "additionalProperties": false,
            "properties": {
              "explanation": {
                "type": "string"
              },
              "operational_state": {
                "type": "string"
              },
              "overall_severity": {
                "type": "string"
              },
              "remediation_actions": {
                "description": "ordered steps; hv_explain_remediation explains each",
                "items": {
                  "type": "string"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "scheduling_advice": {
                "description": "READY, READY_LOW_COVERAGE, MONITOR, DRAIN, RETRY_COLLECTION or NO_VERDICT",
                "type": "string"
              }
            },
            "required": [
              "scheduling_advice",
              "explanation",
              "remediation_actions"
            ],
            "type": "object"
          },
          "error": {
            "type": "string"
          },
          "fence_marker": {
            "type": "string"
          },
          "findings": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "category": {
                  "type": "string"
                },
                "check_id": {
                  "type": "string"
                },
                "entities": {
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "folded_checks": {
                  "description": "how many other gpu_xid_* checks could not read the journal either; they are folded into this finding",
                  "type": "integer"
                },
                "messages": {
                  "description": "fenced node text, or a sentence the server built",
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "name": {
                  "description": "from the compiled-in catalog",
                  "type": "string"
                },
                "observed_values": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "operational_state": {
                  "type": "string"
                },
                "redacted": {
                  "description": "what the server withheld and why",
                  "type": "string"
                },
                "remediation_actions": {
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "severity": {
                  "type": "string"
                },
                "truncated": {
                  "type": "boolean"
                },
                "unrecognized_entities": {
                  "description": "entity names withheld because they did not look like a GPU UUID, PCI address, port or index",
                  "type": "integer"
                }
              },
              "required": [
                "check_id",
                "category",
                "severity"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "passed": {
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "request": {
            "additionalProperties": false,
            "properties": {
              "cadence": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "xid_lookback_minutes": {
                "type": "integer"
              }
            },
            "required": [
              "cadence",
              "detail",
              "xid_lookback_minutes"
            ],
            "type": "object"
          },
          "schema_version": {
            "type": "string"
          },
          "server_catalog_version": {
            "description": "the catalog compiled into this server",
            "type": "string"
          },
          "severity_by_domain": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "skipped": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "check_id": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "check_id",
                "reason"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "timestamp": {
            "type": "string"
          },
          "truncated": {
            "description": "true when lists were cut to fit the caps",
            "type": "boolean"
          },
          "version_skew": {
            "description": "true when serve's catalog differs from this server's",
            "type": "boolean"
          }
        },
        "required": [
          "server_catalog_version",
          "request",
          "findings",
          "decision",
          "version_skew",
          "truncated"
        ],
        "type": "object"
      },
      "title": "Get a node verdict"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "List checks"
      },
      "description": "List the checks in the health-validation catalog compiled into this server, 25 per page, sorted by ID, with each check's domain, cadence, architectures, contexts and maturity. Filter by category, architecture, cadence and maturity. Use hv_describe_check for one check's rules and thresholds. Reads no node; a node's own config may disable some checks.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "architecture": {
            "default": "ANY",
            "description": "only checks that run on this GPU architecture, default ANY",
            "enum": [
              "ANY",
              "A100",
              "B200",
              "B300",
              "GB200",
              "GB300",
              "H100",
              "H200",
              "VR"
            ],
            "type": "string"
          },
          "cadence": {
            "default": "ANY",
            "description": "only checks that run in this scheduling window, default ANY",
            "enum": [
              "ANY",
              "CONTINUOUS",
              "PROLOG",
              "MAINTENANCE"
            ],
            "type": "string"
          },
          "category": {
            "default": "ANY",
            "description": "only checks in this domain, default ANY",
            "enum": [
              "ANY",
              "cpu",
              "gpu",
              "infiniband",
              "node",
              "nvlink",
              "xid"
            ],
            "type": "string"
          },
          "maturity": {
            "default": "ANY",
            "description": "only stable or only experimental checks, default ANY",
            "enum": [
              "ANY",
              "stable",
              "experimental"
            ],
            "type": "string"
          },
          "page": {
            "default": 1,
            "description": "which page of 25 checks, default 1",
            "maximum": 10,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "hv_list_checks",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "catalog_version": {
            "type": "string"
          },
          "checks": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "architectures": {
                  "description": "empty means every architecture",
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "cadence": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "execution_contexts": {
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "maturity": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "category",
                "cadence",
                "maturity",
                "architectures",
                "execution_contexts"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "note": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          },
          "total": {
            "description": "checks matching the filter, across all pages",
            "type": "integer"
          }
        },
        "required": [
          "catalog_version",
          "note",
          "checks",
          "total",
          "page",
          "pages"
        ],
        "type": "object"
      },
      "title": "List checks"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Service status"
      },
      "description": "Check whether the local health-validation serve process answers, through its /healthz endpoint, and list source calls stuck inside it. Also says whether hv_get_verdict is enabled, when it may next run, and which catalog and schema versions this server was built with. Liveness is not node health; use hv_get_verdict for that. Read only; starts no collection.",
      "inputSchema": {
        "additionalProperties": false,
        "type": "object"
      },
      "name": "hv_service_status",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "catalog_version": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "evaluate_available_in_seconds": {
            "description": "0 when hv_get_verdict may run now",
            "type": "integer"
          },
          "evaluate_enabled": {
            "type": "boolean"
          },
          "evaluate_interval_seconds": {
            "type": "integer"
          },
          "evaluate_running": {
            "type": "boolean"
          },
          "fence_marker": {
            "type": "string"
          },
          "liveness": {
            "description": "ok, unhealthy (a source call is stuck), not_available (serve has no /healthz) or unreachable",
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "owner_check": {
            "description": "true when the socket owner is checked before each call",
            "type": "boolean"
          },
          "reachable": {
            "type": "boolean"
          },
          "schema_version": {
            "type": "string"
          },
          "serve_address": {
            "type": "string"
          },
          "stuck_calls": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "since": {
                  "type": "string"
                },
                "source": {
                  "description": "fenced text from serve",
                  "type": "string"
                }
