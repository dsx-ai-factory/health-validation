load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//catalog/cmd/healthschema:health_schema.bzl", "health_schema")

go_library(
    name = "health",
    srcs = [
        "action.go",
        "check.go",
        "classification.go",
        "coerce.go",
        "doc.go",
        "entity.go",
        "enum.go",
        "errors.go",
        "measurement.go",
        "threshold.go",
        "verdict.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/catalog/health",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/version",
        "@com_github_google_uuid//:uuid",
    ],
)

health_schema(
    name = "schema",
    src = ":health",
    visibility = ["//visibility:public"],
)

go_test(
    name = "health_test",
    srcs = [
        "action_test.go",
        "cadence_test.go",
        "check_test.go",
        "classification_test.go",
        "coerce_test.go",
        "entity_test.go",
        "severity_test.go",
        "threshold_test.go",
        "verdict_schema_test.go",
        "verdict_test.go",
    ],
    embed = [":health"],
    embedsrcs = ["node-verdict.schema.json"],
)
