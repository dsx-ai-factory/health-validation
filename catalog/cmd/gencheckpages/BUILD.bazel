load("@aspect_bazel_lib//lib:run_binary.bzl", "run_binary")
load("@rules_go//go:def.bzl", "go_library")
load("//build/rules/go:defs.bzl", "go_binary")

go_library(
    name = "gencheckpages_lib",
    srcs = ["main.go"],
    importpath = "github.com/NVIDIA/health-validation/catalog/cmd/gencheckpages",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "gencheckpages",
    embed = [":gencheckpages_lib"],
    visibility = ["//visibility:public"],
)

run_binary(
    name = "pages",
    srcs = [
        "//catalog/cmd/healthdump:checks",
        "//catalog/health:schema",
    ],
    args = [
        "$(location //catalog/cmd/healthdump:checks)",
        "$(location //catalog/health:schema)",
        "$(RULEDIR)/pages",
    ],
    out_dirs = ["pages"],
    tool = ":gencheckpages",
    visibility = ["//docs:__pkg__"],
)
