load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "nvlink",
    srcs = [
        "measurement.go",
        "nvlink_active.go",
        "nvlink_bandwidth_count_speed.go",
        "nvlink_capabilities.go",
        "nvlink_fabric.go",
        "nvlink_fabric_health.go",
        "nvlink_p2p.go",
    ],
    importpath = "github.com/NVIDIA/health-validation/catalog/nvlink",
    visibility = ["//visibility:public"],
    deps = ["//catalog/health"],
)

go_test(
    name = "nvlink_test",
    srcs = [
        "nvlink_active_test.go",
        "nvlink_bandwidth_count_speed_test.go",
        "nvlink_capabilities_test.go",
        "nvlink_fabric_health_test.go",
        "nvlink_fabric_test.go",
        "nvlink_p2p_test.go",
    ],
    deps = [
        ":nvlink",
        "//catalog",
        "//catalog/health",
    ],
)
